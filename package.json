{
  "name": "antler",
  "version": "1.0.1",
  "description": "Desktop workbench for building LoRA training datasets from e621",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "start:angle:d3d11": "cross-env ANTLER_USE_ANGLE=d3d11 electron .",
    "start:gpu-logging": "cross-env ANTLER_GPU_LOGGING=1 electron .",
    "build": "electron-builder",
    "build-dir": "electron-builder --dir --config.directories.output=dist",
    "dist": "npm run build",
    "make": "node scripts/build.js --menu",
    "test": "jest",
    "lint": "eslint src/ config/",
    "lint:fix": "eslint src/ config/ --fix",
    "clean": "rimraf dist build logs/*.log",
    "models:manifest": "node scripts/model-manifest.js",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "electron",
    "desktop-app",
    "e621",
    "api",
    "tools",
    "lora",
    "dataset"
  ],
  "author": {
    "name": "Piper260",
    "url": "https://github.com/Piper260"
  },
  "license": "ISC",
  "homepage": "https://github.com/Piper260/Antler",
  "repository": {
    "type": "git",
    "url": "https://github.com/Piper260/Antler.git"
  },
  "bugs": {
    "url": "https://github.com/Piper260/Antler/issues"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "image-size": "^2.0.2",
    "joi": "^17.11.0",
    "onnxruntime-node": "^1.30.0",
    "sharp": "^0.35.5",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "44.10.0",
    "electron-builder": "26.17.0",
    "electron-reload": "^2.0.0-alpha.1",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5"
  },
  "build": {
    "appId": "com.piper.aio",
    "productName": "Antler",
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "config/**/*",
      "package.json",
      "!logs/**/*",
      "!tests/**/*",
      "!**/*.test.js",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": true
    },
    "extraResources": [
      {
        "from": "config/",
        "to": "config/"
      },
      {
        "from": "resources/",
        "to": ".",
        "filter": [
          "**/*",
          "!models/**"
        ]
      }
    ],
    "beforePack": "scripts/beforePack.js",
    "afterPack": "scripts/afterPack.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "config/**/*.js",
      "!**/node_modules/**"
    ]
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "browser": true,
      "es2021": true
    },
    "extends": [
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 2021,
      "sourceType": "module"
    },
    "rules": {
      "no-unused-vars": [
        "warn"
      ],
      "no-console": "off",
      "semi": [
        "error",
        "always"
      ],
      "quotes": [
        "error",
        "single"
      ]
    }
  }
}

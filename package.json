{
  "name": "antler",
  "version": "1.2.1",
  "description": "Desktop workbench for building LoRA training datasets from e621",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "start:angle:d3d11": "cross-env ANTLER_USE_ANGLE=d3d11 electron .",
    "start:gpu-logging": "cross-env ANTLER_GPU_LOGGING=1 electron .",
    "build": "electron-builder --publish never",
    "build-dir": "electron-builder --dir --publish never --config.directories.output=dist",
    "dist": "npm run build",
    "make": "node scripts/build.js --menu",
    "release": "node scripts/release.js",
    "test": "jest",
    "lint": "eslint src/ config/",
    "lint:fix": "eslint src/ config/ --fix",
    "clean": "node -e \"for (const d of ['dist', 'build']) require('fs').rmSync(d, { recursive: true, force: true }); for (const f of require('fs').readdirSync('logs', { withFileTypes: true })) if (f.isFile() && f.name.endsWith('.log')) require('fs').rmSync('logs/' + f.name)\"",
    "models:manifest": "node scripts/model-manifest.js",
    "postinstall": "electron-builder install-app-deps",
    "bench:signatures": "electron scripts/signature-bench/main.js",
    "bench:signatures:report": "node scripts/signature-bench/serve.js",
    "bench:signatures:rescore": "node scripts/signature-bench/rescore.js"
  },
  "keywords": [
    "electron",
    "desktop-app",
    "e621",
    "api",
    "tools",
    "lora",
    "dataset"
  ],
  "author": {
    "name": "Piper260",
    "url": "https://github.com/Piper260"
  },
  "license": "ISC",
  "homepage": "https://github.com/Piper260/Antler",
  "repository": {
    "type": "git",
    "url": "https://github.com/Piper260/Antler.git"
  },
  "bugs": {
    "url": "https://github.com/Piper260/Antler/issues"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "image-size": "^2.0.2",
    "joi": "^17.11.0",
    "onnxruntime-node": "^1.30.0",
    "sharp": "^0.35.5",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "7zip-bin": "^5.2.0",
    "cross-env": "^7.0.3",
    "electron": "44.10.0",
    "electron-builder": "26.17.0",
    "electron-reload": "^2.0.0-alpha.1",
    "eslint": "^8.54.0",
    "jest": "^29.7.0"
  },
  "build": {
    "appId": "com.piper.aio",
    "productName": "Antler",
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "config/**/*",
      "package.json",
      "!logs/**/*",
      "!tests/**/*",
      "!**/*.test.js"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": true
    },
    "extraResources": [
      {
        "from": "config/",
        "to": "config/"
      },
      {
        "from": "resources/",
        "to": ".",
        "filter": [
          "**/*",
          "!models/**",
          "!win/**"
        ]
      }
    ],
    "beforePack": "scripts/beforePack.js",
    "afterPack": "scripts/afterPack.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "files": [
        "src/**/*",
        "config/**/*",
        "package.json",
        "!logs/**/*",
        "!tests/**/*",
        "!**/*.test.js",
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
      ],
      "extraResources": [
        {
          "from": "resources/win/",
          "to": "win/"
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "files": [
        "src/**/*",
        "config/**/*",
        "package.json",
        "!logs/**/*",
        "!tests/**/*",
        "!**/*.test.js",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/**"
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "executableName": "antler",
      "synopsis": "LoRA dataset workbench for e621",
      "files": [
        "src/**/*",
        "config/**/*",
        "package.json",
        "!logs/**/*",
        "!tests/**/*",
        "!**/*.test.js",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/arm64/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/x64/libonnxruntime_providers_cuda.so",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/x64/libonnxruntime_providers_tensorrt.so"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "Piper260",
        "repo": "Antler"
      }
    ]
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "config/**/*.js",
      "!**/node_modules/**"
    ]
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "browser": true,
      "es2021": true
    },
    "extends": [
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 2021,
      "sourceType": "module"
    },
    "rules": {
      "no-unused-vars": [
        "warn"
      ],
      "no-console": "off",
      "semi": [
        "error",
        "always"
      ],
      "quotes": [
        "error",
        "single"
      ]
    }
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch": "^11.0.1"
    },
    "@electron/universal": {
      "minimatch": "^11.0.1",
      "dir-compare": {
        "minimatch": "^3.1.2"
      }
    }
  }
}
